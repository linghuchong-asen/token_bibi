{
  "name": "token-bibi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "snapshot": "node scripts/snapshot-data.mjs",
    "import:prices": "node scripts/import-prices.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "collect:openrouter": "node scripts/collect-openrouter.mjs",
    "quality:report": "node scripts/quality-report.mjs",
    "collect:siliconflow": "node scripts/collect-siliconflow.mjs",
    "review:prices": "node scripts/review-prices.mjs",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "automation:run": "node automation/runner.mjs",
    "automation:dry-run": "node automation/runner.mjs --dry-run",
    "automation:status": "node -e \"const s=require('./automation/state.json'); console.log(JSON.stringify(s,null,2))\"",
    "review:sources": "node scripts/review-prices.mjs --check-sources",
    "review:verify-sources": "node scripts/review-prices.mjs --verify-matched",
    "review:demote-stale": "node scripts/review-prices.mjs --demote-stale",
    "changelog:prices": "node scripts/price-changelog.mjs",
    "collect:official": "node scripts/collect-official-prices.mjs",
    "preview": "bash scripts/preview-prod.sh"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "jsdom": "^27.0.0",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
